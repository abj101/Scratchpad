            tensor<bool, []> var_127_keep_dims_0 = const()[name = tensor<string, []>("op_127_keep_dims_0"), val = tensor<bool, []>(false)];
            tensor<fp32, [1, 128, 32]> path_1_cast_fp16_to_fp32 = cast(dtype = path_1_cast_fp16_to_fp32_dtype_0, x = path_1_cast_fp16)[name = tensor<string, []>("cast_3")];
            tensor<fp32, [1, 128]> var_127 = reduce_mean(axes = var_127_axes_0, keep_dims = var_127_keep_dims_0, x = path_1_cast_fp16_to_fp32)[name = tensor<string, []>("op_127")];
            tensor<bool, []> var_130 = const()[name = tensor<string, []>("op_130"), val = tensor<bool, []>(false)];
            tensor<int32, [1]> var_131_axes_0 = const()[name = tensor<string, []>("op_131_axes_0"), val = tensor<int32, [1]>([2])];
            tensor<fp32, [1, 128]> var_131 = reduce_max(axes = var_131_axes_0, keep_dims = var_130, x = path_1_cast_fp16_to_fp32)[name = tensor<string, []>("op_131")];
            tensor<int32, []> var_133 = const()[name = tensor<string, []>("op_133"), val = tensor<int32, []>(1)];
            tensor<bool, []> input_43_interleave_0 = const()[name = tensor<string, []>("input_43_interleave_0"), val = tensor<bool, []>(false)];
            tensor<fp32, [1, 256]> input_43 = concat(axis = var_133, interleave = input_43_interleave_0, values = (var_127, var_131))[name = tensor<string, []>("input_43")];
            tensor<fp32, [1, 128]> path = linear(bias = path_projection_bias, weight = path_projection_weight, x = input_43)[name = tensor<string, []>("linear_1")];
            tensor<int32, []> var_139 = const()[name = tensor<string, []>("op_139"), val = tensor<int32, []>(1)];
            tensor<bool, []> input_45_interleave_0 = const()[name = tensor<string, []>("input_45_interleave_0"), val = tensor<bool, []>(false)];
            tensor<fp32, [1, 194]> input_45 = concat(axis = var_139, interleave = input_45_interleave_0, values = (image, path, strokeGlobals))[name = tensor<string, []>("input_45")];
            tensor<fp32, [1, 256]> var_143 = linear(bias = fusion_bias, weight = fusion_weight, x = input_45)[name = tensor<string, []>("linear_2")];
            tensor<fp32, [1, 256]> embedding = relu(x = var_143)[name = tensor<string, []>("input_47")];
            tensor<fp32, [1, 64]> logits = linear(bias = classifier_bias, weight = classifier_weight, x = embedding)[name = tensor<string, []>("linear_3")];
        } -> (logits, embedding);
}